# DriveDocs AI environment configuration. Copy to .env for local development; never commit .env.
# Every value is optional; defaults come from configs/config.yaml.

# --- Server ---------------------------------------------------------------------------------------------------------
# Render sets PORT automatically (default 10000). Locally uvicorn's --port flag is what matters.
# PORT=8000
DRIVEDOCS_LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from other sites. Empty = same-origin only (the bundled UI).
DRIVEDOCS_CORS_ORIGINS=

# --- Answer generation ----------------------------------------------------------------------------------------------
# extractive (default, no API key, offline) | gemini | openai
LLM_PROVIDER=extractive
# Only needed for the matching provider. Keep real keys out of version control.
GEMINI_API_KEY=
OPENAI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Models & hardware ----------------------------------------------------------------------------------------------
# cpu (default) or cuda. CUDA is used only when requested AND available.
DEVICE=cpu
# onnx (default; ONNX Runtime, ~0.45 GB RAM) | transformers (PyTorch, needs requirements-torch.txt, ~1 GB) | mock (tests)
DRIVEDOCS_EMBEDDING_BACKEND=onnx
# ONNX Runtime threads per model (default min(4, CPU count))
# DRIVEDOCS_ONNX_THREADS=2
# Disable CLIP image search to save ~0.2 GB of RAM (ONNX backend).
DRIVEDOCS_ENABLE_IMAGE_SEARCH=true
# Load models during start-up (in a background thread) instead of on the first request.
DRIVEDOCS_PRELOAD_MODELS=true
# DRIVEDOCS_TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DRIVEDOCS_IMAGE_MODEL=openai/clip-vit-base-patch32
# DRIVEDOCS_MAX_CONCURRENT_INFERENCE=2
# native (default; plain transformers, lower memory) or sentence-transformers (needs the optional package)
# DRIVEDOCS_TEXT_ENCODER=native
# HF_HOME=.hf-cache
# HF_HUB_OFFLINE=1

# --- Storage --------------------------------------------------------------------------------------------------------
# All documents, images, indexes and the registry are written under this directory.
DRIVEDOCS_STORAGE_DIR=data/storage
# Set to true only when DRIVEDOCS_STORAGE_DIR is on durable storage (e.g. a Render persistent disk).
DRIVEDOCS_PERSISTENT_STORAGE=false
# Re-index the bundled sample documents when the library is empty.
DRIVEDOCS_SEED_SAMPLE_DATA=true
DRIVEDOCS_MAX_UPLOAD_MB=15
# DRIVEDOCS_MAX_DOCUMENTS=500

# --- Retrieval tuning (optional) ------------------------------------------------------------------------------------
# DRIVEDOCS_CHUNK_SIZE=500
# DRIVEDOCS_CHUNK_OVERLAP=100
