# DriveDocs Environment Configuration

# Application
DRIVEDOCS_HOST=0.0.0.0
DRIVEDOCS_PORT=8000
DRIVEDOCS_DEBUG=false

# Generation Provider (extractive | gemini | openai)
# Defaults to "extractive" (local offline synthesizer, no API keys needed)
LLM_PROVIDER=extractive

# External API Keys (Optional - only required if LLM_PROVIDER is gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hardware Device override (cpu | cuda)
DEVICE=cpu

# Custom Storage Path (Optional)
DRIVEDOCS_STORAGE_DIR=data/storage
